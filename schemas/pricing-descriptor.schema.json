{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/pricing-descriptor.schema.json",
  "title": "Frozen equivalent Codex API pricing descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "descriptor_id",
    "descriptor_content_sha256",
    "source_urls",
    "retrieved_date",
    "benchmark_effective_date",
    "currency",
    "model_identity",
    "execution_mode",
    "service_tier",
    "region",
    "rate_unit",
    "rates_usd_nanos_per_token",
    "long_context",
    "service_tier_multiplier",
    "regional_processing_multiplier",
    "hosted_tool_rules",
    "billable_attempt_policy",
    "rounding_policy"
  ],
  "properties": {
    "schema_id": {
      "const": "equivalent-model-pricing-descriptor-current"
    },
    "descriptor_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "descriptor_content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://developers\\.openai\\.com/"
      }
    },
    "retrieved_date": {
      "type": "string",
      "format": "date"
    },
    "benchmark_effective_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "const": "USD"
    },
    "model_identity": {
      "const": "gpt-5.6-sol"
    },
    "execution_mode": {
      "const": "standard"
    },
    "service_tier": {
      "const": "standard"
    },
    "region": {
      "const": "global"
    },
    "rate_unit": {
      "const": "USD nanos per token"
    },
    "rates_usd_nanos_per_token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinary_uncached_input",
        "cache_write",
        "cached_input_read",
        "output_including_reasoning"
      ],
      "properties": {
        "ordinary_uncached_input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_read": {
          "type": "integer",
          "minimum": 0
        },
        "output_including_reasoning": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "long_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold_input_tokens",
        "threshold_comparison",
        "input_multiplier",
        "output_multiplier"
      ],
      "properties": {
        "threshold_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "threshold_comparison": {
          "const": "greater_than"
        },
        "input_multiplier": {
          "$ref": "#/$defs/rational"
        },
        "output_multiplier": {
          "$ref": "#/$defs/rational"
        }
      }
    },
    "service_tier_multiplier": {
      "$ref": "#/$defs/rational"
    },
    "regional_processing_multiplier": {
      "$ref": "#/$defs/rational"
    },
    "hosted_tool_rules": {
      "type": "array",
      "maxItems": 0
    },
    "billable_attempt_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_requests",
        "completed_retries",
        "failed_attempts_without_usage"
      ],
      "properties": {
        "completed_requests": {
          "const": "include"
        },
        "completed_retries": {
          "const": "include"
        },
        "failed_attempts_without_usage": {
          "const": "exclude"
        }
      }
    },
    "rounding_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arithmetic",
        "aggregate",
        "presentation_currency_places",
        "presentation_mode"
      ],
      "properties": {
        "arithmetic": {
          "const": "integer_usd_nanos"
        },
        "aggregate": {
          "const": "sum_unrounded_request_values"
        },
        "presentation_currency_places": {
          "const": 2
        },
        "presentation_mode": {
          "const": "half_up"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
