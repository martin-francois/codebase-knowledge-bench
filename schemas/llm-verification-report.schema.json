{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM maintenance verification report v1",
  "type": "object", "additionalProperties": false,
  "required": ["source_commit", "reviewed_artifacts", "checks", "overall_status", "limitations"],
  "properties": {
    "source_commit": {"type": "string", "minLength": 1},
    "reviewed_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "checks": {"type": "array", "minItems": 10, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "evidence", "findings", "residual_uncertainty"],
      "properties": {
        "id": {"pattern": "^LLM-0(0[1-9]|10)$", "type": "string"},
        "status": {"enum": ["passed", "failed", "not_applicable"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "findings": {"type": "array", "items": {"type": "string"}},
        "residual_uncertainty": {"type": "string"}
      }
    }},
    "overall_status": {"enum": ["passed", "failed"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
