{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future Codex token usage vNext",
  "type": "object", "additionalProperties": false,
  "required": ["token_accounting_version", "input_tokens", "cached_input_tokens", "cache_write_tokens", "observed_non_cached_input_tokens", "uncached_nonwrite_input_tokens", "output_tokens_including_reasoning", "reasoning_output_tokens", "non_reasoning_output_tokens_observed", "reasoning_is_subset_of_output", "cache_hit_rate", "cache_write_metrics_available", "cache_write_metrics_unavailable_reason", "usage_scope", "cache_isolation_mode", "prompt_cache_key_hash", "cache_ttl_minimum_seconds", "cache_maximum_retention_known", "cross_arm_cache_reuse_identifiable", "within_arm_cache_reuse_identifiable", "request_level_usage_available", "cache_isolation_experiment_stratum"],
  "properties": {
    "token_accounting_version": {"const": "token-accounting-v2"},
    "input_tokens": {"type": "integer", "minimum": 0}, "cached_input_tokens": {"type": "integer", "minimum": 0},
    "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0}, "observed_non_cached_input_tokens": {"type": "integer", "minimum": 0},
    "uncached_nonwrite_input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens_including_reasoning": {"type": "integer", "minimum": 0},
    "reasoning_output_tokens": {"type": "integer", "minimum": 0}, "cache_hit_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "non_reasoning_output_tokens_observed": {"type": "integer", "minimum": 0}, "reasoning_is_subset_of_output": {"const": true},
    "cache_write_metrics_available": {"type": "boolean"}, "cache_write_metrics_unavailable_reason": {"type": "string"},
    "usage_scope": {"const": "turn_aggregate"}, "cache_isolation_mode": {"enum": ["natural", "per_arm_key", "unknown"]},
    "prompt_cache_key_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "cache_ttl_minimum_seconds": {"const": 1800}, "cache_maximum_retention_known": {"const": false},
    "cross_arm_cache_reuse_identifiable": {"const": false}, "within_arm_cache_reuse_identifiable": {"type": "boolean"},
    "request_level_usage_available": {"type": "boolean"}, "cache_isolation_experiment_stratum": {"enum": ["natural_operational", "cache_isolation_sensitivity"]}
  }
}
