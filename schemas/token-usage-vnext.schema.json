{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future Codex token usage vNext",
  "type": "object", "additionalProperties": false,
  "required": ["input_tokens", "cached_input_tokens", "cache_write_tokens", "non_cached_input_tokens_observed", "uncached_nonwrite_input_tokens", "output_tokens", "reasoning_output_tokens", "cache_hit_rate", "cache_write_metrics_available", "cache_write_metrics_unavailable_reason", "usage_scope", "cache_isolation_mode", "prompt_cache_key_hash", "cache_ttl_minimum_seconds", "cache_maximum_retention_known"],
  "properties": {
    "input_tokens": {"type": "integer", "minimum": 0}, "cached_input_tokens": {"type": "integer", "minimum": 0},
    "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0}, "non_cached_input_tokens_observed": {"type": "integer", "minimum": 0},
    "uncached_nonwrite_input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0},
    "reasoning_output_tokens": {"type": "integer", "minimum": 0}, "cache_hit_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "cache_write_metrics_available": {"type": "boolean"}, "cache_write_metrics_unavailable_reason": {"type": "string"},
    "usage_scope": {"const": "turn_aggregate"}, "cache_isolation_mode": {"enum": ["natural", "per_arm_key", "unknown"]},
    "prompt_cache_key_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "cache_ttl_minimum_seconds": {"const": 1800}, "cache_maximum_retention_known": {"const": false}
  }
}
