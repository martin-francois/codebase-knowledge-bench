  "$id": "operational-tradeoffs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "absolute_quality": {
      "additionalProperties": {
        "$ref": "#/$defs/aggregate"
      },
      "type": "object"
    },
    "baseline": {
      "const": "baseline-none"
    },
    "complete_block_frontier": {
      "$ref": "#/$defs/frontier"
    },
    "correctness_loss_tolerance_grid_points": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "minItems": 6,
      "type": "array",
      "uniqueItems": true
    },
    "correctness_tolerance_lenses": {
      "additionalProperties": {
        "$ref": "#/$defs/lens"
      },
      "type": "object"
    },
    "coverage": {
