{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operational-tradeoffs.schema.json",
  "title": "Authoritative matched operational tradeoffs v3",
  "type": "object",
  "required": ["schema_version", "baseline", "correctness_loss_tolerance_grid_points", "coverage", "absolute_quality", "matched_comparisons", "complete_block_frontier", "pairwise_baseline_relative_frontier", "exact_pareto_frontier", "tolerance_aware_pareto_frontiers", "objective_specific_winners", "correctness_tolerance_lenses", "resource_priority_candidates", "resampling", "operational_stability", "supported_findings", "decision_summary"],
  "properties": {
    "schema_version": {"const": "operational-tradeoffs-v3"},
    "baseline": {"const": "baseline-none"},
    "correctness_loss_tolerance_grid_points": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "number", "minimum": 0}},
    "coverage": {"type": "object", "additionalProperties": {"$ref": "#/$defs/coverage"}},
    "absolute_quality": {"type": "object", "additionalProperties": {"$ref": "#/$defs/aggregate"}},
    "matched_comparisons": {"type": "object", "additionalProperties": {"$ref": "#/$defs/comparison"}},
    "complete_block_frontier": {"$ref": "#/$defs/frontier"},
    "pairwise_baseline_relative_frontier": {"type": "object", "required": ["coverage", "interpretation"]},
    "exact_pareto_frontier": {"type": "array", "items": {"type": "string"}},
    "tolerance_aware_pareto_frontiers": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "objective_specific_winners": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "correctness_tolerance_lenses": {"type": "object", "additionalProperties": {"$ref": "#/$defs/lens"}},
    "resource_priority_candidates": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "preference_profiles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/lens"}},
    "resampling": {"$ref": "#/$defs/schedule"},
    "operational_stability": {"$ref": "#/$defs/stability"},
    "supported_findings": {"type": "object", "required": ["estimable", "correctness_improvements", "correctness_non_inferior_by_tolerance", "lower_tokens", "lower_solve_time", "lower_warm_time", "lower_calls", "strict_dominators", "tolerance_aware_candidates", "exact_frontier_members", "tolerance_frontier_members", "preference_lens_candidates", "preference_independent_winner", "limitations"]},
    "decision_summary": {"type": "object", "required": ["all_implementations_incomplete", "absolute_quality_statement", "preference_independent_overall_winner", "statistically_supported_winner", "pilot_only"]}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "coverage": {
      "type": "object",
      "required": ["scheduled_block_count", "eligible_treatment_block_count", "eligible_matched_block_count", "missing_treatment_blocks", "missing_baseline_blocks", "excluded_blocks", "coverage_fraction", "matched_block_ids", "complete_cross_treatment_comparison_possible"],
      "properties": {
        "scheduled_block_count": {"type": "integer", "minimum": 0},
        "eligible_treatment_block_count": {"type": "integer", "minimum": 0},
        "eligible_matched_block_count": {"type": "integer", "minimum": 0},
        "missing_treatment_blocks": {"type": "array", "items": {"type": "string"}},
        "missing_baseline_blocks": {"type": "array", "items": {"type": "string"}},
        "excluded_blocks": {"type": "array", "items": {"type": "object", "required": ["block_id", "reasons"]}},
        "coverage_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "matched_block_ids": {"type": "array", "items": {"type": "string"}},
        "block_ids_used": {"type": "array", "items": {"type": "string"}},
        "complete_cross_treatment_comparison_possible": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "aggregate": {"type": "object", "required": ["count", "mean", "median", "task_success", "all_tasks_successful"]},
    "interval": {"type": "object", "required": ["estimable", "lower_95", "median", "upper_95"], "properties": {"estimable": {"type": "boolean"}, "lower_95": {"$ref": "#/$defs/nullableNumber"}, "median": {"$ref": "#/$defs/nullableNumber"}, "upper_95": {"$ref": "#/$defs/nullableNumber"}}, "additionalProperties": false},
    "estimability": {"type": "object", "required": ["estimable", "minimum_repetitions_met", "minimum_issue_clusters_met", "issue_cluster_count", "issue_cluster_status", "reason"], "properties": {"estimable": {"type": "boolean"}, "minimum_repetitions_met": {"type": "boolean"}, "minimum_issue_clusters_met": {"type": "boolean"}, "issue_cluster_count": {"type": "integer", "minimum": 0}, "issue_cluster_status": {"enum": ["insufficient_issue_clusters", "limited_cluster_evidence", "broader_across_task_evidence"]}, "reason": {"type": ["string", "null"]}}, "additionalProperties": false},
    "schedule": {"type": "object", "required": ["version", "seed", "resamples", "block_universe", "issue_order", "schedule_sha256", "algorithm"], "properties": {"version": {"const": "hierarchical-matched-block-schedule-v2"}, "seed": {"type": "integer"}, "resamples": {"type": "integer", "minimum": 0}, "block_universe": {"type": "array", "items": {"type": "string"}}, "issue_order": {"type": "array", "items": {"type": "string"}}, "schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "algorithm": {"type": "string"}, "scope": {"type": "string"}}, "additionalProperties": false},
    "comparison": {"type": "object", "required": ["variant", "coverage", "absolute_quality", "paired_effects", "within_issue_dispersion", "across_issue_heterogeneity", "issue_sensitivity", "repetition_sensitivity", "missing_block_sensitivity", "timeout_sensitivity", "infrastructure_sensitivity", "break_even", "operational_tradeoff_sensitivity", "resampling", "paired_intervals", "uncertainty_status", "estimability"], "properties": {"coverage": {"$ref": "#/$defs/coverage"}, "resampling": {"$ref": "#/$defs/schedule"}, "paired_intervals": {"type": "object", "additionalProperties": {"$ref": "#/$defs/interval"}}, "estimability": {"$ref": "#/$defs/estimability"}}, "additionalProperties": true},
    "frontier": {"type": "object", "required": ["status", "block_ids", "treatments", "members", "reason"], "properties": {"status": {"enum": ["comparable", "not_comparable"]}, "block_ids": {"type": "array", "items": {"type": "string"}}, "treatments": {"type": "array", "items": {"type": "string"}}, "members": {"type": "array", "items": {"type": "string"}}, "reason": {"type": ["string", "null"]}}, "additionalProperties": false},
    "lens": {"type": "object", "required": ["maximum_correctness_loss_points", "candidate_treatments", "reasons"]},
    "stability": {"type": "object", "required": ["estimable", "reason", "resample_count", "exact_pareto_frontier_membership", "tolerance_aware_pareto_frontier_membership", "objective_winner_membership", "preference_profile_candidate_membership"]}
  },
  "additionalProperties": false
}
