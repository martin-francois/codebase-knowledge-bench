        "coverage": {
          "type": "object"
        },
        "interpretation": {
          "type": "string"
        }
      },
      "required": [
        "coverage",
        "interpretation"
      ],
      "type": "object"
    },
    "preference_profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/lens"
      },
      "type": "object"
    },
    "resampling": {
      "$ref": "#/$defs/schedule"
    },
    "resource_priority_candidates": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "type": "object"
    },
