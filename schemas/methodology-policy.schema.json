        "prior_terminal_model_turns",
        "prior_valid_measured_rows",
        "prior_diagnostically_reconstructed_valid_rows",
        "prior_approval_requests",
        "prior_unintended_later_model_turns",
        "prior_request_count",
        "prior_cost_status",
        "prior_exact_cost_available",
        "prior_exact_cost_usd_nanos",
