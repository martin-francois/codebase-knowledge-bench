# Resolve only versions published at least seven days ago (npm 11.10 or newer).
# Renovate's minimumReleaseAge only filters the versions Renovate proposes. Lockfile
# maintenance and a local npm install let npm pick every version, so the cooldown lives here.
# npm cannot exempt a single version. To take a security fix that is younger than
# seven days, add min-release-age-exclude[]=<package> with the advisory in a comment,
# and remove the line once that version is seven days old.
min-release-age=7
# source-map-js 1.2.2 fixes GHSA-68fv-2mgg-jv7q and was published 2026-09-30T14:08Z.
# Remove this line on or after 2026-10-07T14:08Z, when 1.2.2 passes the seven-day window.
min-release-age-exclude[]=source-map-js
